# Copy this to .env and adjust as needed (never commit .env)
# Leave VITE_API_URL empty on Vercel so the app calls the backend on the same
# origin (the vercel.json rewrites route /api/* to the backend service).
VITE_API_URL=http://localhost:5000/api/v1

# Google sign-in. This is NOT a secret — it is the same "Web application" OAuth
# client ID used by the backend. Vite inlines it at build time, so it must be set
# in Vercel's environment variables BEFORE the build runs, and every domain you
# serve from must be listed under "Authorized JavaScript origins":
#   https://console.cloud.google.com/apis/credentials
#     - http://localhost:5173
#     - https://<your-project>.vercel.app
VITE_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
