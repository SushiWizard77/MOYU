# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Env files - NEVER push real secrets
.env
backend/.env
frontend/.env
*.local

# Build outputs
dist/
frontend/dist/
frontend/dist-ssr/
build/

# Logs
*.log
logs/
backend/server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Debug / scratch dumps at repo root (96x *.txt, lint reports, patches)
# Keeps the GitHub repo clean - local files stay on disk, just not committed
/*.txt
/lint.json
/lintparse.js
/patch_eslint2.cjs
/lint-c.sh

# Frontend scratch dumps accidentally saved inside src/
frontend/src/*Raw.txt
frontend/src/*raw.txt
frontend/src/_files.txt

# OS / Editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.kombai/
