# Copy this to .env and fill in real values (never commit .env)
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-long-random-string>
CLIENT_ORIGIN=http://localhost:5173

# Google sign-in. Create a "Web application" OAuth client in the Google Cloud
# console and use its client ID here (no client secret is needed — MOYU verifies
# the ID token against Google's public keys):
#   https://console.cloud.google.com/apis/credentials
# Must be the SAME client ID as the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com

# Optional seed config
SEED_ADMIN_EMAIL=admin@moyu.dev
SEED_ADMIN_PASSWORD=MoyuAdmin@123
